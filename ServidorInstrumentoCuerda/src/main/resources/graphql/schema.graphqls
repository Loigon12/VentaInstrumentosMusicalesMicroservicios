type Query {
    instrumento(nombre: String, precioMaximo: Float): [Instrumento]
    instrumentoPorCodigo(codigo: Int!): Instrumento
    accesorio: [AccesorioCuerda]
    accesorioPorCodigo(codigo: Int!): AccesorioCuerda
}

type Mutation {
    addInstrumento(input: InstrumentoInput!): Instrumento
    delInstrumento(input: Int!): Instrumento
    editInstrumento(input: InstrumentoInput!): Instrumento
    addAccesorio(input: AccesorioCuerdaInput!): AccesorioCuerda
    delAccesorio(input: Int!): AccesorioCuerda
    editAccesorio(input: AccesorioCuerdaInput!): AccesorioCuerda
}

input InstrumentoInput {
    id: ID!
    nombre: String!
    precio: Float!
    fechaVenta: String!
    numeroCuerdas: Int!
    numeroTrastes: Int!
}

type Instrumento {
    id: ID
    objectId: ID
    nombre: String
    precio: Float
    fechaVenta: String
    numeroCuerdas: Int
    numeroTrastes: Int
    accesorio: [AccesorioResumen]
}

# Dentro de Instrumento, cada accesorio vinculado solo muestra su id normal
type AccesorioResumen {
    id: ID
}

input AccesorioCuerdaInput {
    id: ID!
    nombre: String!
    tipo: Tipo!
    precio: Float!
    marca: String!
    idInstrumento: ID!
}

type AccesorioCuerda {
    id: ID
    objectId: ID
    nombre: String
    tipo: Tipo
    precio: Float
    marca: String
    idInstrumento: ID
    objectIdInstrumento: ID
}

enum Tipo {
    CUERDAPULSADA,
    CUERDAFROTADA
}
