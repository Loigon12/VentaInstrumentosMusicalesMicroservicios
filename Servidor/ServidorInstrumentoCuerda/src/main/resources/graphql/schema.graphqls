type Query {
    instrumento(nombre: String, precioMaximo: Float): [Instrumento]
    instrumentoPorCodigo(codigo: Int!): Instrumento
    instrumentoConAccesorios(codigo: Int!): Instrumento
    accesorio: [AccesorioCuerda]
    accesorioPorCodigo(codigo: Int!): AccesorioCuerda
    instrumentoViento(nombre: String, precioMaximo: Float): [InstrumentoViento]
    instrumentoVientoPorCodigo(codigo: Int!): InstrumentoViento
}

type Mutation {
    addInstrumento(input: InstrumentoInput!): Instrumento
    delInstrumento(input: Int!): Instrumento
    editInstrumento(input: InstrumentoInput!): Instrumento
    addAccesorio(input: AccesorioCuerdaInput!): AccesorioCuerda
    delAccesorio(input: Int!): AccesorioCuerda
    editAccesorio(input: AccesorioCuerdaInput!): AccesorioCuerda
    addInstrumentoViento(input: InstrumentoVientoInput!): InstrumentoViento
    delInstrumentoViento(input: Int!): InstrumentoViento
    editInstrumentoViento(input: InstrumentoVientoInput!): InstrumentoViento
}

input InstrumentoInput {
    id: ID!
    nombre: String!
    precio: Float!
    fechaVenta: String!
    numeroCuerdas: Int!
    numeroTrastes: Int!
    fechaRegistro: String
}

type Instrumento {
    id: ID
    objectId: ID
    nombre: String
    precio: Float
    fechaVenta: String
    fechaRegistro: String
    numeroCuerdas: Int
    numeroTrastes: Int
    accesorio: [AccesorioCuerda]
}

input AccesorioCuerdaInput {
    id: ID!
    nombre: String!
    tipo: Tipo!
    precio: Float!
    marca: String!
    idInstrumento: ID!
    fechaRegistro: String
}

type AccesorioCuerda {
    id: ID
    objectId: ID
    nombre: String
    tipo: Tipo
    precio: Float
    marca: String
    idInstrumento: ID
    objectIdInstrumento: ID
    fechaRegistro: String
}

enum Tipo {
    CUERDAPULSADA,
    CUERDAFROTADA
}

input InstrumentoVientoInput {
    id: ID!
    nombre: String!
    precio: Float!
    fechaVenta: String!
    numeroLlaves: Int!
    tipoBoquilla: String!
    fechaRegistro: String
}

type InstrumentoViento {
    id: ID
    objectId: ID
    nombre: String
    precio: Float
    fechaVenta: String
    fechaRegistro: String
    numeroLlaves: Int
    tipoBoquilla: String
}
